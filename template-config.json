{
  "buckets": {
    "d68ad087-df37-44cf-bd53-5ba208d12393": {
      "name": "Files"
    }
  },
  "services": {
    "13576f70-f99c-404a-ac16-364172cc1b17": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/directus/main/icon.svg",
      "name": "Directus",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/server/ping",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "directus/directus:12.5.0"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:8055": {
            "port": 8055
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {},
      "variables": {
        "ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "Admin login, created on first boot (change it later in the user settings)",
          "isOptional": false
        },
        "ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password, created on first boot",
          "isOptional": false
        },
        "SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs access tokens and sessions",
          "isOptional": false
        },
        "PUBLIC_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of Directus",
          "isOptional": false
        },
        "DB_CLIENT": {
          "defaultValue": "pg",
          "description": "Database driver",
          "isOptional": false
        },
        "DB_CONNECTION_STRING": {
          "defaultValue": "postgresql://${{PostGIS.POSTGRES_USER}}:${{PostGIS.POSTGRES_PASSWORD}}@${{PostGIS.RAILWAY_PRIVATE_DOMAIN}}:5432/${{PostGIS.POSTGRES_DB}}",
          "description": "Postgres over Railway's private network",
          "isOptional": false
        },
        "STORAGE_LOCATIONS": {
          "defaultValue": "s3",
          "description": "Uploads go to the Railway bucket",
          "isOptional": false
        },
        "STORAGE_S3_DRIVER": {
          "defaultValue": "s3",
          "description": "S3 storage driver",
          "isOptional": false
        },
        "STORAGE_S3_KEY": {
          "defaultValue": "${{Files.ACCESS_KEY_ID}}",
          "description": "Bucket access key",
          "isOptional": false
        },
        "STORAGE_S3_SECRET": {
          "defaultValue": "${{Files.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key",
          "isOptional": false
        },
        "STORAGE_S3_BUCKET": {
          "defaultValue": "${{Files.BUCKET}}",
          "description": "Bucket name",
          "isOptional": false
        },
        "STORAGE_S3_REGION": {
          "defaultValue": "${{Files.REGION}}",
          "description": "Bucket region",
          "isOptional": false
        },
        "STORAGE_S3_ENDPOINT": {
          "defaultValue": "${{Files.ENDPOINT}}",
          "description": "Bucket endpoint",
          "isOptional": false
        },
        "EXTENSIONS_LOCATION": {
          "defaultValue": "s3",
          "description": "Marketplace extensions are stored in the bucket, so they survive redeploys",
          "isOptional": false
        },
        "WEBSOCKETS_ENABLED": {
          "defaultValue": "true",
          "description": "Realtime API over WebSockets",
          "isOptional": false
        },
        "IP_TRUST_PROXY": {
          "defaultValue": "true",
          "description": "Trust Railway's proxy for client IPs",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "8055",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        }
      }
    },
    "5bbae571-e0e2-4534-9814-1b93c6ccbd25": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "PostGIS",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "postgis/postgis:17-3.6-alpine"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "1cab9bd2-6e37-42af-98eb-94fa4b3c2596": {
          "mountPath": "/var/lib/postgresql/data"
        }
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "directus",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "directus",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      }
    }
  }
}